# Clave de la API de Groq (capa gratuita, sin tarjeta).
# Consiguela en https://console.groq.com/keys y copiala aqui.
# Copia este archivo a .env (que NO se sube al repo) y rellena el valor.
GROQ_API_KEY=tu_clave_de_groq_aqui

# Modelo de Groq a usar. Llama se esta retirando de Groq; por defecto Qwen.
# Alternativas: qwen/qwen3.6-27b | openai/gpt-oss-120b | llama-3.3-70b-versatile
MODELO_LLM=qwen/qwen3.6-27b
